<!doctype html>
<html lang="ja">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %> | kintone擬似AI v2</title>
  <link rel="stylesheet" href="/static/css/style.css" />
</head>
<body>
  <div class="bg-shape"></div>
  <header class="site-header">
    <a class="brand" href="/">
      <span class="brand-name">kintone擬似AI <span class="brand-ver">v2</span></span>
      <span class="brand-tag">FDE × kintone Backend × MCP</span>
    </a>
    <% if (currentUser) { %>
      <% const navItems = [
        ["/dashboard", "ダッシュボード"],
        ["/operator", "AIオペレーター"],
        ["/records/analyze", "レコード分析"],
        ["/records/new", "1件登録"],
        ["/audit", "AI操作ログ"],
        ["/apps/manage", "アプリ管理"],
        ["/tokens", "トークン・AI設定"]
      ]; %>
      <nav>
        <% navItems.forEach(([href, label]) => { %>
          <a href="<%= href %>" class="<%= currentPath === href ? 'active' : '' %>"><%= label %></a>
        <% }) %>
      </nav>
      <form method="post" action="/auth/logout">
        <button type="submit" class="ghost">ログアウト</button>
      </form>
    <% } %>
  </header>

  <main class="container">
    <% if (error) { %>
      <p class="alert error"><%= error %></p>
    <% } %>
    <% if (message) { %>
      <p class="alert success"><%= message %></p>
    <% } %>
