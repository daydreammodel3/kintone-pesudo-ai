<%- include('partials/header', { title }) %>

<section class="panel">
  <h1>ダッシュボード</h1>
  <p class="hint">フロント ＝ 生成AI / ツール層（MCP相当）、バックエンド ＝ kintone。AIの操作はすべてkintoneの権限と操作ログの内側で動きます。</p>

  <ol class="arch-flow" aria-label="アーキテクチャ">
    <li class="arch-node">
      <span class="arch-kicker">現場 / FDE</span>
      <strong>自然言語で依頼</strong>
      <% if (!isGuest) { %><a href="/operator">AIオペレーター →</a><% } %>
    </li>
    <li class="arch-node">
      <span class="arch-kicker">生成AI</span>
      <strong><%= providerLabel %></strong>
      <% if (!isGuest) { %><a href="/tokens">AI設定 →</a><% } %>
    </li>
    <li class="arch-node">
      <span class="arch-kicker">ツール層（MCP相当）</span>
      <strong>ポリシーで公開範囲を制御</strong>
      <% if (!isGuest) { %><a href="/apps/manage">AI操作ポリシー →</a><% } %>
    </li>
    <li class="arch-node arch-node-kintone">
      <span class="arch-kicker">kintone</span>
      <strong>データ・権限・監査</strong>
      <% if (!isGuest) { %><a href="/audit">AI操作ログ →</a><% } %>
    </li>
  </ol>
</section>

<section class="stat-row">
  <div class="stat">
    <span class="stat-value"><%= apps.length %></span>
    <span class="stat-label">接続中のkintoneアプリ</span>
  </div>
  <div class="stat">
    <span class="stat-value"><%= fieldCount %></span>
    <span class="stat-label">kintoneから同期したフィールド</span>
  </div>
  <div class="stat">
    <span class="stat-value"><%= opCounts.ok || 0 %></span>
    <span class="stat-label">AIによる操作（成功）</span>
  </div>
  <div class="stat">
    <span class="stat-value"><%= (opCounts.denied_policy || 0) + (opCounts.denied_kintone || 0) %></span>
    <span class="stat-label">権限・ポリシーで拒否</span>
  </div>
</section>

<section class="panel">
  <h2>最近のAI操作</h2>
  <% if (!recentOps.length) { %>
    <p class="hint">まだAI操作はありません。<% if (!isGuest) { %><a href="/operator">AIオペレーター</a>から依頼してみてください。<% } %></p>
  <% } else { %>
    <div class="table-wrap">
      <table>
        <thead><tr><th>日時(UTC)</th><% if (isGuest) { %><th>ユーザー</th><% } %><th>アプリ</th><th>ツール</th><th>結果</th><th>内容</th></tr></thead>
        <tbody>
          <% recentOps.forEach((op) => { %>
            <tr>
              <td class="nowrap"><%= op.created_at %></td>
              <% if (isGuest) { %><td><%= op.username %></td><% } %>
              <td><%= op.app_name %></td>
              <td><code><%= op.tool_name %></code></td>
              <td><span class="badge badge-<%= op.status %>"><%= statusLabels[op.status] || op.status %></span></td>
              <td><%= op.summary %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <% if (!isGuest) { %><p><a href="/audit">すべての操作ログを見る →</a></p><% } %>
  <% } %>
</section>

<section class="panel">
  <h2>最近の分析ジョブ</h2>
  <% if (!jobs.length) { %>
    <p class="hint">まだジョブがありません。</p>
  <% } else { %>
    <div class="table-wrap">
      <table>
        <thead><tr><th>ID</th><% if (isGuest) { %><th>ユーザー</th><% } %><th>状態</th><th>作成</th><th>更新</th></tr></thead>
        <tbody>
          <% jobs.forEach((job) => { %>
            <tr>
              <td><%= job.id %></td>
              <% if (isGuest) { %><td><%= job.username %></td><% } %>
              <td><%= job.status %></td>
              <td><%= job.created_at %></td>
              <td><%= job.updated_at %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <p><a href="/records/analyze">分析結果を見る →</a></p>
  <% } %>
</section>

<%- include('partials/footer') %>
