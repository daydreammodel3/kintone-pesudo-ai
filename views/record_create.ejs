<%- include('partials/header', { title }) %>

<section class="panel">
  <h1>POSTによる1件登録</h1>
  <% if (!apps.length) { %>
    <p class="hint">先に「アプリ管理」で共通アプリを登録してください。</p>
  <% } %>
  <p class="hint">入力欄はkintoneから同期したフィールド構成から自動生成しています。kintone側で項目を追加したら「kintoneから同期」を押すだけで、この画面に反映されます。</p>

  <div class="panel-head">
    <form method="get" action="/records/new" class="form-grid wide grow">
      <label>対象のkintoneアプリ
        <select name="appId" onchange="this.form.submit()" required>
          <% apps.forEach((a) => { %>
            <option value="<%= a.id %>" <%= selectedApp && selectedApp.id === a.id ? 'selected' : '' %>>
              <%= a.app_name %> (<%= a.kintone_domain %> / appId: <%= a.kintone_app_id %>)
            </option>
          <% }) %>
        </select>
      </label>
      <noscript><button type="submit">切り替え</button></noscript>
    </form>
    <% if (selectedApp) { %>
      <form method="post" action="/apps/manage/<%= selectedApp.id %>/sync">
        <input type="hidden" name="returnTo" value="/records/new?appId=<%= selectedApp.id %>" />
        <button type="submit" class="ghost">kintoneから同期</button>
      </form>
    <% } %>
  </div>

  <form method="post" action="/records" class="form-grid wide">
    <input type="hidden" name="managedAppId" value="<%= selectedApp ? selectedApp.id : '' %>" />
    <% if (postFields && postFields.length) { %>
      <% postFields.forEach((field) => { const name = `field_${field.id}`; %>
        <label><span><%= field.field_name %><% if (field.required) { %> <span class="req">*</span><% } %> <span class="hint">（<%= field.field_code %> / <%= field.field_type %>）</span></span>
          <% if ((field.field_type === 'DROP_DOWN' || field.field_type === 'RADIO_BUTTON') && field.options.length) { %>
            <select name="<%= name %>" <%= field.required ? 'required' : '' %>>
              <option value="">（未選択）</option>
              <% field.options.forEach((o) => { %><option value="<%= o %>"><%= o %></option><% }) %>
            </select>
          <% } else if (field.field_type === 'MULTI_LINE_TEXT' || field.field_type === 'RICH_TEXT') { %>
            <textarea name="<%= name %>" rows="4" <%= field.required ? 'required' : '' %>></textarea>
          <% } else if (field.field_type === 'DATE') { %>
            <input type="date" name="<%= name %>" <%= field.required ? 'required' : '' %> />
          <% } else if (field.field_type === 'NUMBER') { %>
            <input type="number" step="any" name="<%= name %>" <%= field.required ? 'required' : '' %> />
          <% } else { %>
            <input type="text" name="<%= name %>" <%= field.required ? 'required' : '' %>
              placeholder="<%= field.options.length ? '選択肢: ' + field.options.join(', ') + '（カンマ区切り）' : '値を入力（配列/オブジェクトはJSON入力可）' %>" />
          <% } %>
        </label>
      <% }) %>
    <% } else { %>
      <p class="hint">選択中アプリにPOST対象フィールドがありません。「kintoneから同期」を実行するか、アプリ管理で設定してください。</p>
    <% } %>
    <button type="submit" <%= (!apps.length || !postFields.length) ? 'disabled' : '' %>>登録する</button>
  </form>
</section>

<%- include('partials/footer') %>
