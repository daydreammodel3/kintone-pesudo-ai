PORT=3000
# HTTPS（npm run https:cert で証明書を作ったときだけ待ち受ける）
HTTPS_PORT=3443
# npm run mdns-alias で公開する別名（kinpai → https://kinpai.local:3443）。空なら使わない
MDNS_ALIAS=kinpai
SESSION_SECRET=change-this-session-secret
# 32バイト鍵をbase64で指定（推奨）
# 例: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY_BASE64=
# 上記未設定時のローカル開発用フォールバック
TOKEN_ENCRYPTION_PASSPHRASE=local-dev-only

# Gemini API（Google）
# APIキーはユーザーごとに画面から保存します（ここには書きません）
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_MS=120000
# 混雑(503)・429・500系の試行回数（初回を含む）
GEMINI_RETRY_ATTEMPTS=4
# 再試行しても混雑が続くときに切り替えるモデル（空で無効）
GEMINI_FALLBACK_MODEL=gemini-3.6-flash

# GitHub Models（2026/7/30 提供終了。互換エンドポイントを使う場合のみ）
COPILOT_API_BASE=https://models.inference.ai.azure.com
COPILOT_MODEL=gpt-4o-mini
COPILOT_TIMEOUT_MS=45000

# Claude API（Anthropic・任意）
# APIキーはユーザーごとに画面から保存します（ここには書きません）
ANTHROPIC_MODEL=claude-opus-5
# low | medium | high | xhigh | max（空ならモデルのデフォルト）
ANTHROPIC_EFFORT=
# default: 安全性分類器で辞退された場合にサーバー側で推奨モデルへ自動フォールバック / off: 無効
ANTHROPIC_FALLBACKS=default
ANTHROPIC_TIMEOUT_MS=120000

# AIオペレーターが1回の依頼で呼べるツールの最大回数
AI_MAX_TOOL_STEPS=8
